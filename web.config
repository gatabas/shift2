<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- IIS'in statik dosyaları işlemesine izin ver -->
        <modules runAllManagedModulesForAllRequests="false" />
        
        <rewrite>
            <rules>
                <!-- /shift/api/* istekleri Node.js'e yönlendir -->
                <rule name="ShiftAPI" stopProcessing="true">
                    <match url="^shift/api/(.*)" />
                    <action type="Rewrite" url="http://localhost:3000/api/{R:1}" appendQueryString="true" />
                </rule>
                
                <!-- /shift/* statik dosyalar (html, js, css, img) -->
                <rule name="ShiftStatic" stopProcessing="false">
                    <match url="^shift/(.+\.(html|js|css|png|jpg|jpeg|gif|svg|ico))$" />
                    <action type="None" />
                </rule>
                
                <!-- /shift veya /shift/ -> index.html -->
                <rule name="ShiftRoot" stopProcessing="true">
                    <match url="^shift/?$" />
                    <action type="Rewrite" url="http://localhost:3000/" appendQueryString="true" />
                </rule>
                
                <!-- Diğer /shift/* istekleri Node.js'e -->
                <rule name="ShiftOther" stopProcessing="true">
                    <match url="^shift/(.*)" />
                    <action type="Rewrite" url="http://localhost:3000/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>
        
        <!-- Detaylı hata mesajları (production'da kapatın) -->
        <httpErrors errorMode="Detailed" />
        
        <!-- CORS headers (gerekirse) -->
        <httpProtocol>
            <customHeaders>
                <add name="Access-Control-Allow-Origin" value="*" />
                <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
                <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
